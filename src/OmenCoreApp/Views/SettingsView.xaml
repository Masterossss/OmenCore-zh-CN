                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsWiFiTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsLabelBatch89}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch99}" Text="{Binding WiFiSSID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsLidTrigger, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsLabelBatch90}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox ItemTemplate="{StaticResource SettingsOptionTemplate}" AutomationProperties.Name="{x:Static loc:Strings.SettingsLabelBatch90}" ItemsSource="{Binding LidStates}" SelectedItem="{Binding LidState, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText3611Text}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox ItemTemplate="{StaticResource SettingsOptionTemplate}" AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch100}" ItemsSource="{Binding FanPresetOptions}" SelectedItem="{Binding FanPreset, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText3617Text}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox ItemTemplate="{StaticResource SettingsOptionTemplate}" AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch101}" ItemsSource="{Binding PerformanceModeOptions}" SelectedItem="{Binding PerformanceMode, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernComboBox}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Padding="10,8" CornerRadius="6" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1AF44336"/>
                                                                <Setter Property="BorderBrush" Value="#33F44336"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ValidationMessage}" Value="Ready">
                                                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                                                        <Setter Property="BorderBrush" Value="#334CAF50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="11" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ValidationMessage}" Value="Ready">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.RowSpan="3" Panel.ZIndex="1000" />
    </Grid>
</UserControl>
