<UserControl x:Class="OmenCore.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:OmenCore.Controls"
             xmlns:utils="clr-namespace:OmenCore.Utils"
             xmlns:loc="clr-namespace:OmenCore.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <UserControl.Resources>
        <loc:SettingsOptionDisplayConverter x:Key="SettingsOptionDisplay"/>
        <DataTemplate x:Key="SettingsOptionTemplate"><TextBlock Text="{Binding Converter={StaticResource SettingsOptionDisplay}}"/></DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220" MinWidth="180"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static loc:Strings.SettingsLabelBatch0}"
                           FontSize="28" FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText28Text}"
                           FontSize="12" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Opacity="0.9"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <!-- Search box -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Bottom">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="14" Height="14" Fill="{StaticResource TextTertiaryBrush}" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch0}" Grid.Column="1" Text="{Binding SettingsSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="12" VerticalAlignment="Center"
                             CaretBrush="{StaticResource TextPrimaryBrush}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Search results panel -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,8"
                Visibility="{Binding SettingsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText62Text}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding SettingsSearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource AccentBlueBrush}" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TabName}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Sub-tabs for easier navigation (GitHub #48 - kg290) -->
        <TabControl Grid.Row="2" Style="{StaticResource ModernTabControl}" ItemContainerStyle="{StaticResource ModernTabItem}" Margin="0,8,0,0">
            <!-- Status Tab -->
            <TabItem Header="{x:Static loc:Strings.SettingsLabelBatch1}">
                <ScrollViewer Style="{StaticResource SmoothScrollViewer}" 
                              IsDeferredScrollingEnabled="True"
                              Padding="0,0,12,0">
                    <StackPanel>
                        <!-- System Status Section -->
                <Border Style="{StaticResource PremiumPanelCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconMonitoring}" 
                                  Fill="#4CAF50" 
                                  Width="24" Height="24" Stretch="Uniform" 
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText100Text}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <!-- Backend Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText111Text}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText113Text}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1A4CAF50" CornerRadius="4" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FanBackend, FallbackValue=Detecting...}" 
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Secure Boot Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText133Text}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Secure Boot is disabled — legacy unsigned drivers available"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SecureBootEnabled}" Value="True">
                                                    <Setter Property="Text" Value="Secure Boot enabled — unsigned drivers blocked. PawnIO or WMI BIOS provides compatible access."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="4" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SecureBootEnabled}" Value="True">
                                                <Setter Property="Background" Value="#1AFF9800"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Disabled"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SecureBootEnabled}" Value="True">
                                                    <Setter Property="Text" Value="🔒 Enabled"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        
                        <!-- PawnIO Status -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding SecureBootEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText183Text}" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText185Text}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="4" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1AF44336"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PawnIOAvailable}" Value="True">
                                                <Setter Property="Background" Value="#1A4CAF50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not Installed"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PawnIOAvailable}" Value="True">
                                                    <Setter Property="Text" Value="✓ Installed"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        
                        <!-- OGH Status -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OMEN Gaming Hub" FontSize="14" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText225Text}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <!-- Show detection detail when OGH is detected -->
                                <TextBlock Text="{Binding OghDetectionDetail}" 
                                           FontSize="10" 
                                           Foreground="#FF9800"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding OghInstalled, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="4" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A808080"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OghInstalled}" Value="True">
                                                <Setter Property="Background" Value="#1AFF9800"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not Detected"/>
                                            <Setter Property="Foreground" Value="#808080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OghInstalled}" Value="True">
                                                    <Setter Property="Text" Value="⚠ Running"/>
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        
                        <!-- Standalone Status (v2.7.0) -->
                        <Border Margin="0,16,0,0" Padding="16" CornerRadius="8" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A00FF88"/>
                                    <Setter Property="BorderBrush" Value="#4000FF88"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StandaloneStatus}" Value="Degraded">
                                            <Setter Property="Background" Value="#1AFFD93D"/>
                                            <Setter Property="BorderBrush" Value="#40FFD93D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StandaloneStatus}" Value="Limited">
                                            <Setter Property="Background" Value="#1AFF6B6B"/>
                                            <Setter Property="BorderBrush" Value="#40FF6B6B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="🔍" FontSize="24"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText292Text}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StandaloneStatusSummary, FallbackValue=Checking dependencies...}" 
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2000FF88"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StandaloneStatus}" Value="Degraded">
                                                    <Setter Property="Background" Value="#20FFD93D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StandaloneStatus}" Value="Limited">
                                                    <Setter Property="Background" Value="#20FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StandaloneStatus, FallbackValue=Checking...}" 
                                               FontSize="13" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#00FF88"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StandaloneStatus}" Value="Degraded">
                                                        <Setter Property="Foreground" Value="#FFD93D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StandaloneStatus}" Value="Limited">
                                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                                Background="{StaticResource SurfaceDarkBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsLabelBatch2}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ResumeRecoverySummary}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ResumeRecoveryLastUpdated}" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="0,4,0,0"/>
                                    <TextBox AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch1}" Text="{Binding ResumeRecoveryTimeline}"
                                             Margin="0,10,0,0"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="96"
                                             FontFamily="{StaticResource MonospaceFontFamily}"
                                             Background="{StaticResource SurfaceDarkBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1A4CAF50" CornerRadius="4" Padding="12,6" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding ResumeRecoveryStatus}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="16" CornerRadius="8"
                                Background="{StaticResource SurfaceDarkBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText373Text}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ModelIdentitySummary}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                                            Background="#1400C8C8"
                                            BorderBrush="#3000C8C8"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText388Text}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ModelIdentityResolvedModel}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText401Text}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ModelIdentityResolutionSource}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText408Text}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ModelIdentityConfidence}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText421Text}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ModelIdentityKeyboardModel}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText428Text}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ModelIdentityKeyboardSource}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ModelIdentityKeyboardConfidence}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                            BorderThickness="1"
                                            Visibility="{Binding ModelIdentityHasWarning, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1AFFD93D"/>
                                                <Setter Property="BorderBrush" Value="#40FFD93D"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ModelIdentityWarningText}" FontSize="11"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="{Binding ModelIdentityRawSummary}" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               FontFamily="{StaticResource MonospaceFontFamily}"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                                <WrapPanel Margin="0,12,0,0" VerticalAlignment="Top">
                                    <Border CornerRadius="4" Padding="12,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1AFFD93D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModelIdentityBadgeTone}" Value="success">
                                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ModelIdentityBadgeTone}" Value="error">
                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ModelIdentityBadgeText}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModelIdentityBadgeTone}" Value="success">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ModelIdentityBadgeTone}" Value="error">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button AutomationProperties.Name="{x:Static loc:Strings.SettingsAccessibleBatch2}" Content="{x:Static loc:Strings.SettingsReferenceText488Content}"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding CopyModelIdentitySummaryCommand}"
                                            Padding="12,6" Margin="10,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- PawnIO-Only Mode Toggle (v2.7.0) -->
                        <Border Margin="0,12,0,0" Padding="16" CornerRadius="8" 
                                Background="{StaticResource SurfaceDarkBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText506Text}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.SafetyFollowup0}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.SafetyFollowup1}" Grid.Column="1" IsChecked="{Binding PawnIOOnlyMode}"
                                              Style="{StaticResource ModernToggleButton}" 
                                              VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        
                        <!-- BIOS Reliability Stats (v2.7.0) -->
                        <Border Margin="0,12,0,0" Padding="16" CornerRadius="8" 
                                Background="{StaticResource SurfaceDarkBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.SettingsReferenceText528Text}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding BiosReliabilityText, FallbackValue=Waiting for commands...}" 
                                               FontSize="12" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding BiosReliabilityColor}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BiosReliabilityStats.IsUsingLegacyWmi}" Value="True">
                                                        <Setter Property="Text" Value="Using Legacy WMI (BIOS F.15+ fallback)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button AutomationProperties.Name="{x:Static loc:Strings.SettingsLabelBatch3}" Grid.Column="1" Content="{x:Static loc:Strings.SettingsLabelBatch3}"
                                        Style="{StaticResource ModernButton}"
                                        Command="{Binding RefreshBiosReliabilityCommand}"
                                        Padding="12,6" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
