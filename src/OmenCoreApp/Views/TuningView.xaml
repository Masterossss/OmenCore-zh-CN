                        <Border Background="#0D1520" BorderBrush="#2A3441" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.TuningViewText730}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding SystemControl.AmdLimitReadbackText}"
                                           FontSize="13" FontFamily="{StaticResource MonospaceFontFamily}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SystemControl.AmdLimitReadbackAvailable, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Text="{Binding SystemControl.AmdLimitReadbackSourceText}"
                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding SystemControl.AmdLimitReadbackAvailable, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Text="{Binding SystemControl.AmdLimitReadbackMismatchText}"
