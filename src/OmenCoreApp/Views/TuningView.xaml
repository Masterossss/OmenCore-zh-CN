                                <TextBlock Text="{Binding SystemControl.AmdPowerLimitsStatus}"
                                           FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24">
                        <Border Background="#0D1520"
                                BorderBrush="#FF9800"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,20">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="STAPM" FontWeight="SemiBold" Foreground="#FFB74D"/>
                                <Run Text="{x:Static loc:Strings.TuningExplainBatch2}"/>
                                <Run Text="Tctl" FontWeight="SemiBold" Foreground="#FFB74D"/>
                                <Run Text="{x:Static loc:Strings.TuningExplainBatch3}"/>
                            </TextBlock>
                        </Border>

                        <Border Background="#0A0A12" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="STAPM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.TuningViewText685}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <Slider Grid.Column="1" TickFrequency="1"
