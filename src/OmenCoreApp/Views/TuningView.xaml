                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding SystemControl.AmdLimitReadbackDiffersFromRequest, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Text="{Binding SystemControl.AmdLimitReadbackUnavailableText}"
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SystemControl.ShowAmdLimitReadbackUnavailable, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static loc:Strings.TuningViewText758}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SystemControl.RefreshAmdPowerLimitReadbackCommand}"
                                    Padding="16,8" Margin="0,0,8,0"
                                    ToolTip="{x:Static loc:Strings.TuningViewText762}"
                                    AutomationProperties.Name="{x:Static loc:Strings.TuningDiagBatch7}"/>
                            <Button Content="{x:Static loc:Strings.TuningViewText764}"
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding SystemControl.ApplyAmdPowerLimitsCommand}"
                                    Padding="16,8" Margin="0,0,8,0"
                                    ToolTip="{x:Static loc:Strings.TuningViewText768}"
                                    AutomationProperties.Name="{x:Static loc:Strings.TuningDiagBatch8}"/>
                            <Button Content="{x:Static loc:Strings.TuningViewText770}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SystemControl.ResetAmdPowerLimitsCommand}"
                                    Padding="16,8"
                                    ToolTip="{x:Static loc:Strings.TuningViewText774}"
                                    AutomationProperties.Name="{x:Static loc:Strings.TuningDiagBatch9}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding SystemControl.ShowAmdPowerUnavailableMessage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.TuningViewText784}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SystemControl.AmdPowerLimitsStatus}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- TCC Offset Section - Enhanced Design -->
            <Border Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,0,0,16"
                    Visibility="{Binding SystemControl.TccStatus.IsSupported, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Border Grid.Row="0" Background="#0A0A12" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#12121A" CornerRadius="8" 
                                    Padding="10" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Image Width="32" Height="32">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="pack://application:,,,/OmenCore;component/Assets/intel.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SystemControl.CpuVendor}" Value="AMD">
                                                    <Setter Property="Source" Value="pack://application:,,,/OmenCore;component/Assets/amd.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static loc:Strings.TuningViewText826}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{x:Static loc:Strings.TuningViewText828}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Margin="24">
                        
                        <!-- TCC Slider - Enhanced -->
                        <Border Background="#0A0A12" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.TuningViewText847}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="°C reduction" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                                
                                <Slider Grid.Column="1" 
                                        Value="{Binding SystemControl.RequestedTccOffset, Mode=TwoWay}"
                                        Minimum="0" Maximum="30"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Margin="16,0"/>
                                
                                <Border Grid.Column="2" Background="#12121A" CornerRadius="4" 
                                        Padding="8,4" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SystemControl.RequestedTccOffset, StringFormat={}{0}°C}"
                                               FontFamily="{StaticResource MonospaceFontFamily}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#4CAF50"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Reference info -->
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20" TextWrapping="Wrap">
                            <Run Text="0°C" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/> <Run Text="{x:Static loc:Strings.TuningExplainBatch4}"/>
                            <Run Text="15°C" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/> <Run Text="{x:Static loc:Strings.TuningExplainBatch5}"/>
                            <Run Text="30°C" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/> <Run Text="{x:Static loc:Strings.TuningExplainBatch6}"/>
                        </TextBlock>

                        <!-- Apply Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static loc:Strings.TuningViewText880}"
                                    Style="{StaticResource ModernButton}"
                                    Command="{Binding SystemControl.ApplyTccOffsetCommand}"
                                    Padding="16,8" Margin="0,0,8,0"
                                    ToolTip="{x:Static loc:Strings.TuningViewText884}"
                                    AutomationProperties.Name="{x:Static loc:Strings.TuningDiagBatch10}"/>

                            <Button Content="{x:Static loc:Strings.TuningViewText887}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SystemControl.ResetTccOffsetCommand}"
                                    Padding="16,8"
                                    ToolTip="{x:Static loc:Strings.TuningViewText891}"
                                    AutomationProperties.Name="{x:Static loc:Strings.TuningDiagBatch11}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- GPU SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            
            <TextBlock Text="{x:Static loc:Strings.TuningViewText902}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,24,0,16"
                       Visibility="{Binding SystemControl.GpuOcSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- NVIDIA driver power policy (read-only) -->
