                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <Border Background="#12121A" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding SystemControl.AmdStapmLimitText}" FontFamily="{StaticResource MonospaceFontFamily}"
                                                   FontSize="14" FontWeight="Bold" Foreground="#FFB74D" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#0A0A12" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.TuningViewText709}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.TuningViewText710}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <Slider Grid.Column="1" Minimum="75" Maximum="105" TickFrequency="5"
                                        Value="{Binding SystemControl.AmdTempLimitC, Mode=TwoWay}"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="16,0"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <Border Background="#12121A" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding SystemControl.AmdTempLimitText}" FontFamily="{StaticResource MonospaceFontFamily}"
                                                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- What the SMU is actually enforcing, as opposed to what was asked for.
